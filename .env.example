# Copy to .env and fill in. Everything is optional for local development.
PORT=3000
APP_URL=http://localhost:3000
# Comma-separated emails that become admins when they sign up or log in.
ADMIN_EMAILS=
# SMTP connection string for verification emails, e.g. smtps://user:pass@smtp.example.com:465
# Without it, codes are printed to the server log and returned by the API (dev only).
SMTP_URL=
MAIL_FROM=Backstretch <no-reply@example.com>
# Enables the GIF search button in comments. Free key: https://developers.giphy.com
GIPHY_API_KEY=
# Where the database, uploads, and generated secret live.
DATA_DIR=var
# Set to 1 behind a reverse proxy (needed for correct per-IP rate limits).
TRUST_PROXY=0
# How long a college verification lasts before re-verifying.
COLLEGE_VERIFY_DAYS=365
